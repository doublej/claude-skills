<!--
  Home page starter — flt-quality structure. Replace the placeholder content
  (steps, features, commands) with real project content extracted from the README.
  Keep the section order and the Terminal-based demo: it is what makes the site
  "look good" rather than generic.
-->
<script lang="ts">
  import { base } from '$app/paths'
  import { obliterate } from 'orphan-obliterator'
  import { onMount } from 'svelte'
  import Terminal from '$lib/components/Terminal.svelte'

  type Mode = 'run' | 'install' | 'agent'
  let mode = $state<Mode>('install')
  let copied = $state(false)
  let step = $state(0)

  // TODO: one entry per frame of the animated demo. Tell a real end-to-end story.
  const steps = [
    { title: 'First command', description: 'Describe the real task a user accomplishes here.' },
    { title: 'Second command', description: 'Build on the previous step — show progression.' },
    { title: 'Result', description: 'Show the payoff: the output the user wanted.' },
  ]

  // TODO: real install/run commands for this project.
  const display_map: Record<Mode, string> = {
    run: 'bunx github:{{REPO_SLUG}}',
    install: 'bun install -g github:{{REPO_SLUG}}',
    agent: 'bunx github:{{REPO_SLUG}} prime',
  }
  const copy_map: Record<Mode, string> = {
    run: 'bunx github:{{REPO_SLUG}}',
    install: 'bun install -g github:{{REPO_SLUG}}',
    agent: 'bunx github:{{REPO_SLUG}} prime',
  }

  // TODO: real features (3 or 6 reads best in the grid).
  const features = [
    { icon: '⇄', title: 'Feature one', description: 'What it does and why it matters.' },
    { icon: '◇', title: 'Feature two', description: 'What it does and why it matters.' },
    { icon: '★', title: 'Feature three', description: 'What it does and why it matters.' },
  ]

  onMount(() => {
    const instance = obliterate({
      selectors: ['p', '.tagline', '.description', '.feature-card p'],
      rules: { minLastLineWords: 3, maxProtectedChars: 40 },
    })
    return () => instance.destroy()
  })

  function copyCommand() {
    navigator.clipboard.writeText(copy_map[mode])
    copied = true
    setTimeout(() => (copied = false), 2000)
  }
</script>

<main>
  <section class="hero">
    <div class="container">
      <h1>{{PROJECT_TITLE}}</h1>
      <p class="tagline">{{PROJECT_DESCRIPTION}}</p>

      <div class="hero-actions">
        <div class="mode-toggle">
          <button class:active={mode === 'run'} onclick={() => (mode = 'run')}>Run</button>
          <button class:active={mode === 'install'} onclick={() => (mode = 'install')}>Install</button>
          <button class:active={mode === 'agent'} onclick={() => (mode = 'agent')}>Agent</button>
        </div>
        <div class="command-box">
          <code>{display_map[mode]}</code>
          <button class="copy-btn" onclick={copyCommand}>{copied ? 'Copied' : 'Copy'}</button>
        </div>
      </div>

      <div class="hero-links">
        <a href="{{REPO_URL}}" target="_blank" rel="noopener noreferrer" class="hero-link">View on GitHub</a>
      </div>
    </div>
  </section>

  <section class="demo">
    <div class="container">
      <div class="demo-header">
        <div class="demo-header-text">
          <h2>{steps[step].title}</h2>
          <p class="description">{steps[step].description}</p>
        </div>
        <div class="demo-nav">
          <button class="nav-arrow" disabled={step === 0} onclick={() => step--}>&larr;</button>
          <span class="demo-count">{step + 1} / {steps.length}</span>
          <button class="nav-arrow" disabled={step === steps.length - 1} onclick={() => step++}>&rarr;</button>
        </div>
      </div>
      <Terminal>
        <!-- TODO: render the command + output for `steps[step]`. Use <span class="tg">…</span>
             for green terminal text, and a `.tg-prompt` for the $ prompt. -->
        <div><span class="tg-prompt">$</span> command for step {step + 1}</div>
        <div>output line…</div>
      </Terminal>
    </div>
  </section>

  <section class="features">
    <div class="container">
      <h2>What it does</h2>
      <div class="grid">
        {#each features as feature}
          <div class="feature-card">
            <div class="feature-icon">{feature.icon}</div>
            <h3>{feature.title}</h3>
            <p>{feature.description}</p>
          </div>
        {/each}
      </div>
      <div class="features-cta">
        <a href="{base}/features" class="features-link">See all features &rarr;</a>
      </div>
    </div>
  </section>

  <section class="cta">
    <div class="container">
      <h2>Ready to start?</h2>
      <pre class="cta-install"><code>{display_map.install}</code></pre>
      <p><a href="{{REPO_URL}}" target="_blank" rel="noopener noreferrer">GitHub</a> · MIT License</p>
    </div>
  </section>
</main>

